# Copied to .env by `make setup`. .env is gitignored — these are dev-only values.
DB_NAME=joomla
DB_USER=joomla
DB_PASSWORD=joomla
DB_ROOT_PASSWORD=root

JOOMLA_SITE_NAME=Joomla 6 Dev
JOOMLA_ADMIN_USER=Dev Admin
JOOMLA_ADMIN_USERNAME=admin
# Joomla rejects anything under 12 characters.
JOOMLA_ADMIN_PASSWORD=devpassword123
JOOMLA_ADMIN_EMAIL=dev@joomla.test

# Change if 80/443 are already taken; the URL then needs the port.
HTTP_PORT=80
HTTPS_PORT=443
